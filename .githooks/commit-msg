#!/usr/bin/env bash
# git-dod :: commit-msg hook (hard gate)
#
#  1) every commit must use a KNOWN conventional type — no divergence
#     (typos like "update:" / "feture:" are rejected);
#  2) behaviour types (default: feat, fix) must carry "Why:" and "Expected:"
#     lines — the git log IS the work-log, so rationale and expected outcome
#     live in the commit message.
#
# Merge / Revert / fixup! / squash! subjects are skipped. Bypass once with
# [skip-checks] in the message.
#
# Nothing here is repo-specific: per-repo settings live in .git-dod.conf at the
# repo root (see docs/adapting.md). Do not edit this file to adapt it.
set -u

msgfile="${1:?commit-msg: missing message file arg}"

# ---- defaults (overridable in .git-dod.conf) --------------------------------
TYPES="feat fix refactor perf docs test chore style build ci revert"
EXPLAIN_TYPES="feat fix"
REQUIRED_TRAILERS="Why Expected"
JIRA_PREFIX="auto"          # auto | on | off
SKIP_TOKEN="[skip-checks]"

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] && [ -f "$root/.git-dod.conf" ] && . "$root/.git-dod.conf"

# ---- read the message -------------------------------------------------------
body="$(grep -v '^#' "$msgfile" 2>/dev/null || true)"
subject="$(printf '%s\n' "$body" | sed '/^[[:space:]]*$/d' | head -1)"

case "$subject" in
  Merge*|Revert*|"fixup!"*|"squash!"*|"") exit 0 ;;
esac

printf '%s\n' "$body" | grep -qF -- "$SKIP_TOKEN" && exit 0

fail() {
  { printf '\n✗ commit-msg (git-dod): %s\n' "$1"; shift
    for l in "$@"; do printf '  %s\n' "$l"; done
    printf '  Bypass once: add %s to the message.\n\n' "$SKIP_TOKEN"
  } >&2
  exit 1
}

# ---- strip an optional issue key: "[ABC-123] " or "ABC-123 " ----------------
line="$subject"
case "$JIRA_PREFIX" in
  auto|on)
    stripped="$(printf '%s' "$line" | sed -E 's/^\[[A-Z][A-Z0-9_]+-[0-9]+\][[:space:]]*//; s/^[A-Z][A-Z0-9_]+-[0-9]+[[:space:]]+//')"
    if [ "$JIRA_PREFIX" = "on" ] && [ "$stripped" = "$line" ]; then
      fail "subject must start with an issue key, e.g. '[ABC-123]feat(scope): summary'."
    fi
    line="$stripped"
    ;;
esac

# ---- type must be present and known ----------------------------------------
type="$(printf '%s' "$line" | sed -nE 's/^([a-zA-Z]+)(\([^)]*\))?!?:.*/\1/p')"
[ -n "$type" ] || fail "use a conventional prefix 'type(scope): summary'." \
  "Got: $subject" "Allowed types: $TYPES"

case " $TYPES " in
  *" $type "*) : ;;
  *) fail "unknown commit type '$type'." "Allowed types: $TYPES" ;;
esac

# ---- behaviour types must explain themselves --------------------------------
case " $EXPLAIN_TYPES " in
  *" $type "*)
    missing=""
    for key in $REQUIRED_TRAILERS; do
      printf '%s\n' "$body" | grep -qiE "^[[:space:]]*${key}:[[:space:]]*\S" || missing="$missing $key:"
    done
    [ -z "$missing" ] || fail "'$type' commits must include$missing" \
      "" \
      "Example:" \
      "  fix(player): keep the snap stage inside the PWA safe area" \
      "" \
      "  Why: in standalone PWA the top of the image hid under the notch." \
      "  Expected: no panel is clipped by the notch; desktop unchanged."
    ;;
esac
exit 0
